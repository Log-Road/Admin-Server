generator client {
  provider        = "prisma-client-js"
  output          = "./client"
  previewFeatures = ["views"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRESQL_DB")
}

model Contests {
  id        String             @id @default(uuid())
  name      String
  status    COMPETITION_STATUS @default(ONGOING)
  place     String
  purpose   String
  audience  String
  endDate   DateTime           @default(now()) @map("end_date")
  startDate DateTime           @default(now()) @map("start_date")
  Awards    Awards[]
  Projects  Projects[]
  Vote      Vote[]
  Winner    Winner[]
}

model Projects {
  id           String         @id @default(uuid())
  name         String
  image        String
  members      String[]
  skills       String[]
  status       PROJECT_STATUS
  introduction String
  description  String
  place        String
  CreatedAt    DateTime       @default(now())
  authCategory CATEGORY       @map("auth_ategory")
  contestId    String         @map("contest_id")
  videoLink    String         @map("video_link")
  Like         Like[]
  contest      Contests       @relation(fields: [contestId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  Vote         Vote[]
}

model Awards {
  id        String   @id @default(uuid())
  name      String
  count     Int
  contestId String   @map("contest_id")
  contest   Contests @relation(fields: [contestId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  Winner    Winner[]
}

model Vote {
  contestId String   @map("contest_id")
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  contest   Contests @relation(fields: [contestId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  project   Projects @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([projectId, userId])
}

model Like {
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  project   Projects @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([projectId, userId])
}

model Club {
  clubId   String  @id @default(uuid()) @map("club_id")
  clubName String  @unique @map("club_name")
  isActive Boolean @default(true) @map("is_active")
}

model Winner {
  id        String   @id @default(uuid())
  awardId   String   @map("award_id")
  contestId String   @map("contest_id")
  userId    String   @map("user_id")
  award     Awards   @relation(fields: [awardId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  contest   Contests @relation(fields: [contestId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([awardId, userId])
}

enum COMPETITION_STATUS {
  ONGOING
  IN_PROGRESS
  PENDING_AWARD
  CLOSED
}

enum PROJECT_STATUS {
  PENDING
  APPROVAL
  REJECTED
  MODIFICATION
  DELETION
}

enum CATEGORY {
  PERSONAL
  TEAM
  CLUB
}

enum ROLE {
  Student
  Teacher
  Admin
}

view User {
  userId            String @id @unique @map("user_id")
  userStringId      String @map("user_string_id")
  userName          String @map("user_name")
  userRole          ROLE   @map("user_role")
  userStudentNumber Int    @map("user_student_number")

  @@map("foreign_user")
}
